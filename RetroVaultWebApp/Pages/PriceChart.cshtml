@page
@model RetroVaultWebApp.Pages.PriceChartModel
@{
    ViewData["Title"] = "PriceChart";
}
<h1>PriceChart</h1>
Investigated @Model.CountedItems.ToString("N0", Model.NumberCulture) of @Model.TotalItems.ToString("N0", Model.NumberCulture) items currently in the vault.
<br />
@Model.NumItemsWithPriceData.ToString("N0", Model.NumberCulture) items contains price data and is thus included in this report.
<small class="text-muted">(Number format: @Model.NumberCulture.DisplayName)</small>
<br />
<br />
<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Overall Compare</h5>
        <table class="table table-sm table-striped table-bordered my-column-stripes">
            <tbody>
                <tr><th>Price Info</th><th>Total Worth</th></tr>
                @foreach (var kv in Model.CostData)
                {
                    <tr>
                        <td>@kv.Key</td>
                        <td>@kv.Value.ToString("N0", Model.NumberCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<br />
Comparing CIB purchases towards PriceChart: @(Model.DiffCIB.ToString("N0", Model.NumberCulture))
<br />
Comparing Loose purchases towards PriceChart: @(Model.DiffLoose.ToString("N0", Model.NumberCulture))
<br />
<br />
<br />
<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Biggest Winners</h5>
        <table class="table table-sm table-striped table-bordered my-column-stripes">
            <tbody>
                <tr><th>Item Id</th><th>Total Diff</th></tr>
                @foreach (var kv in Model.TopTenWinners)
                {
                    <tr>
                        <td><a href="/Details?id=@kv.Key.ToString()">@kv.Key.ToString()</a></td>
                        <td>@kv.Value.ToString("N0", Model.NumberCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<br />
<br />
<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Biggest Loosers</h5>
        <table class="table table-sm table-striped table-bordered my-column-stripes">
            <tbody>
                <tr><th>Item Id</th><th>Total Diff</th></tr>
                @foreach (var kv in Model.TopTenLoosers)
                {
                    <tr>
                        <td><a href="/Details?id=@kv.Key.ToString()">@kv.Key.ToString()</a></td>
                        <td>@kv.Value.ToString("N0", Model.NumberCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
