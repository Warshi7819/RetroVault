@page
@model RetroVaultWebApp.Pages.Setup.PriceChartingModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "PriceCharting Setup";
}

<h2 class="mb-4"><i class="bi bi-currency-dollar"></i> PriceCharting Setup</h2>

<div class="card mb-4" style="max-width: 560px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-search"></i> Test PriceCharting URL</h5>
        <p class="text-muted small mb-3">
            Enter a PriceCharting URL to verify loose and complete prices are extracted correctly.
        </p>
        <form method="post" asp-page-handler="TestUrl" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col">
                <label class="form-label">URL</label>
                <input type="url" asp-for="TestUrl" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-play"></i> Test
                </button>
            </div>
        </form>

        @if (Model.TestResultAvailable)
        {
            <hr />
            <div class="mb-0">
                <strong>Loose:</strong> @(Model.TestLoosePrice ?? "not found")<br />
                <strong>Complete:</strong> @(Model.TestCompletePrice ?? "not found")
            </div>
        }
    </div>
</div>

<div class="card mb-4" style="max-width: 560px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-arrow-repeat"></i> Update Prices</h5>
        <p class="text-muted small mb-3">
            Trigger a background job to fetch updated PriceCharting prices for all vault items
            with a URL that hasn't been updated in the last 7 days. Runs at 1 item per @Model.UpdateIntervalSeconds seconds.
        </p>

        <form method="post" asp-page-handler="TriggerUpdate" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" id="btn-start">
                <i class="bi bi-play-fill"></i> Start Update
            </button>
        </form>

        <div id="progress-section" class="mt-3" style="display:none;">
            <div class="mb-1" id="progress-status"></div>
            <div class="progress mb-1" style="height: 6px;">
                <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar" style="width: 0%"></div>
            </div>
            <small class="text-muted" id="progress-current"></small>
        </div>

        <div id="progress-done" class="mt-3" style="display:none;">
            <div class="alert alert-success py-2 mb-0" id="progress-done-text"></div>
        </div>

        <div id="progress-error" class="mt-3" style="display:none;">
            <div class="alert alert-danger py-2 mb-0" id="progress-error-text"></div>
        </div>
    </div>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Missing PriceCharting URL</h5>
        <p class="text-muted small mb-3">
            These items do not have a PriceCharting URL assigned.
        </p>

        @if (Model.MissingItems.Count == 0)
        {
            <div class="text-muted">All items have a PriceCharting URL.</div>
        }
        else
        {
            <table class="table table-sm table-striped table-bordered my-column-stripes">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>System</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MissingItems)
                    {
                        <tr>
                            <td><a href="/Details?id=@item.Id">@item.Id</a></td>
                            <td>@item.Name</td>
                            <td>@item.System</td>
                            <td>@item.Category</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script nonce="@(HttpContext.Items["CSP-Nonce"])">
        (function () {
            var progressSection = document.getElementById('progress-section');
            var progressDone = document.getElementById('progress-done');
            var progressError = document.getElementById('progress-error');
            var progressBar = document.getElementById('progress-bar');
            var progressStatus = document.getElementById('progress-status');
            var progressCurrent = document.getElementById('progress-current');
            var progressDoneText = document.getElementById('progress-done-text');
            var progressErrorText = document.getElementById('progress-error-text');
            var btnStart = document.getElementById('btn-start');
            var interval = null;

            function poll() {
                fetch('?handler=Progress')
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d.isRunning) {
                            progressSection.style.display = '';
                            progressDone.style.display = 'none';
                            progressError.style.display = 'none';
                            btnStart.disabled = true;

                            var pct = d.totalItems > 0
                                ? Math.round((d.processedCount / d.totalItems) * 100)
                                : 0;
                            progressBar.style.width = pct + '%';
                            progressStatus.textContent = d.statusMessage || '';
                            progressCurrent.textContent = d.currentItemName
                                ? 'Current: ' + d.currentItemName
                                : '';
                        } else {
                            clearInterval(interval);
                            btnStart.disabled = false;

                            if (d.completedAt) {
                                progressDone.style.display = '';
                                progressDoneText.textContent = 'Completed at ' + d.completedAt;
                                progressSection.style.display = 'none';
                            }
                            if (d.errorMessage) {
                                progressError.style.display = '';
                                progressErrorText.textContent = d.errorMessage;
                            }
                        }
                    });
            }

            poll();
            interval = setInterval(poll, 5000);
        })();
    </script>
}
