@page
@model RetroVaultWebApp.Pages.Settings.ProfileModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Profile";
}

<h2 class="mb-4"><i class="bi bi-person"></i> Profile</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
}

<div class="card mb-4" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-person-badge"></i> Alias</h5>
        <form method="post" asp-page-handler="UpdateAlias" class="row g-2 align-items-end">
            <div class="col">
                <label class="form-label">Display name</label>
                <input type="text" name="Alias" class="form-control" maxlength="100"
                       value="@Model.CurrentAlias" placeholder="Leave empty to show username">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-currency-exchange"></i> Preferred Currency</h5>
        <p class="text-muted small mb-3">
            Used when converting PriceCharting prices from USD.
        </p>
        <form method="post" asp-page-handler="UpdateCurrency" class="row g-2 align-items-end">
            <div class="col">
                <label class="form-label">Currency</label>
                <select name="preferredCurrency" class="form-select">
                    @foreach (var c in ProfileModel.Currencies)
                    {
                        <option value="@c" selected="@(c == Model.CurrentPreferredCurrency)">@c</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-translate"></i> Number Format</h5>
        <p class="text-muted small mb-0">
            Detected from your browser's language: <strong>@Model.NumberFormatDisplayName</strong>.
            This controls how numbers are formatted on the PriceChart and Reports pages
            (e.g. <strong>1 000</strong> vs <strong>1,000</strong>).
            Change it in your browser settings to adjust.
        </p>
    </div>
</div>

<div class="card" style="max-width: 480px;">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-key"></i> Change Password</h5>
        <form method="post" class="row g-3">
            <div class="col-12">
                <label class="form-label">Current password</label>
                <input type="password" name="CurrentPassword" class="form-control" required autocomplete="current-password">
            </div>
            <div class="col-12">
                <label class="form-label">New password</label>
                <input type="password" name="NewPassword" class="form-control" required autocomplete="new-password">
            </div>
            <div class="col-12">
                <label class="form-label">Confirm new password</label>
                <input type="password" name="ConfirmPassword" class="form-control" required autocomplete="new-password">
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><i class="bi bi-key"></i> Change password</button>
            </div>
        </form>
    </div>
</div>
