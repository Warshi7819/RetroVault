@page
@model RetroVaultWebApp.Pages.DetailsModel
@{
    ViewData["Title"] = "Details";
}

@if (Model.Item == null)
{
    <h2>Item not found</h2>
    <a asp-page="Index" class="btn btn-secondary mt-3">Back</a>
}
else
{
    <div class="container mt-3">

        <div class="row">
            <div class="col-12 text-center mb-3">
                <!-- Thumbnail -->
                <img src="/images/thumbnails/@(Model.Item.Id).png"
                     alt="@Model.Item.Name thumbnail"
                     class="img-fluid rounded shadow-sm"
                     style="max-height: 200px; object-fit: contain;" />
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <h5 class="card-title mb-3">
                    @Model.Item.Name
                    @if (Model.Item.Sold == "Yes")
                    {
                        <span class="badge bg-danger ms-2">SOLD</span>
                    }
                </h5>

                <table class="table table-sm table-striped">
                    <tbody>
                        <tr><th>System</th><td>@Model.Item.System</td></tr>
                        <tr><th>Category</th><td>@Model.Item.Category</td></tr>
                        <tr><th>Region</th><td>@Model.Item.Region</td></tr>
                        <tr><th>Developer</th><td>@Model.Item.Developer</td></tr>
                        <tr><th>Publisher</th><td>@Model.Item.Publisher</td></tr>
                        <tr><th>Year</th><td>@Model.Item.Year</td></tr>
                        <tr><th>Acquired</th><td>@Model.Item.AcquiredDate (@Model.Item.AcquiredFrom)</td></tr>
                        <tr><th>Completeness</th><td>@Model.Item.Completeness</td></tr>
                        <tr><th>Storage Location</th><td>@Model.Item.StorageLocation</td></tr>
                        <tr><th>Purchase Price</th><td>@Model.Item.PurchasePrice @Model.Item.Currency</td></tr>
                        @if (Model.Item.Sold == "Yes")
                        {
                            <tr><th>Sold Price</th><td>@Model.Item.SalePrice @Model.Item.Currency</td></tr>
                        }
                        <tr><th>Description</th><td style="white-space: pre-wrap;">@Model.Item.Description</td></tr>
                        @if (Model.Item.PriceChartingLoosePrice > 0 && Model.Item.PriceChartingCompletePrice > 0)
                        {
                            <tr><th>PriceChart (CIB)</th><td>@Model.Item.PriceChartingCompletePrice @Model.Item.Currency</td></tr>
                            <tr><th>PriceChart (Loose)</th><td>@Model.Item.PriceChartingLoosePrice @Model.Item.Currency</td></tr>
                            <tr><th>PriceChart URL</th><td><a href="@Model.Item.PriceChartingURL">URL</a></td></tr>
                            <tr><th>PriceChart (Last Updated)</th><td>@Model.Item.PriceChartingLastUpdated</td></tr>
                        }
                    </tbody>
                </table>


            </div>
        </div>

        <div class="mt-3">
            <a asp-page="CreateEdit"
               asp-route-id="@Model.Item.Id"
               class="btn btn-primary me-2">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Item.Id" class="d-inline delete-confirm" id="delete-form"
                  data-confirm-msg="Are you sure you want to delete @(Model.Item.Name)?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Name" value="@Model.Name" />
                <input type="hidden" name="System" value="@Model.System" />
                <input type="hidden" name="Category" value="@Model.Category" />
                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                <input type="hidden" name="Search" value="true" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </form>
            <a asp-page="Index"
               asp-route-name="@Model.Name"
               asp-route-system="@Model.System"
               asp-route-category="@Model.Category"
               asp-route-pageNumber="@Model.PageNumber"
               asp-route-search="true"
               class="btn btn-secondary">
                Back to Search
            </a>
        </div>

    </div>
}
