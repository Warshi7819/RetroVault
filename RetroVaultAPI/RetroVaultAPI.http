@rootURL = http://localhost:5149

### GET ALL
GET {{rootURL}}/api/VaultItem/
Accept: application/json

### GET All Categories
GET {{rootURL}}/api/VaultItem/categories
Accept: application/json

### GET All Systems
GET {{rootURL}}/api/VaultItem/systems
Accept: application/json

### GET BY ID
GET {{rootURL}}/api/VaultItem/-1
Accept: application/json
### CREATE NEW
POST {{rootURL}}/api/VaultItem/
Content-Type: application/json
{
  "name": "XBOX Game 2 FTW",
  "purchasePrice": "30",
  "system": "Xbox",
  "category": "Games",
  "completeness": "Disc,Box",
  "priceChartingLoosePrice": 10,
  "priceChartingCompletePrice": 20,
  "priceChartingLastUpdated": "2026-07-07"
}
### UPDATE EXISTING
PUT {{rootURL}}/api/VaultItem/5
Content-Type: application/json
{
  "name": "XBOX Game FTW",
  "purchasePrice": "15",
  "system": "Xbox",
  "category": "Games",
  "completeness": "CIB",
  "priceChartingLoosePrice": 10,
  "priceChartingCompletePrice": 20,
  "priceChartingLastUpdated": "2026-07-07"
}
### DELETE
DELETE {{rootURL}}/api/VaultItem/2
Accept: application/json

### SEARCH
GET {{rootURL}}/api/VaultItem/search?name=upDated
Accept: application/json

### LIST ITEM FILES (recursive, per category)
GET {{rootURL}}/api/VaultItem/11/files
Accept: application/json

### DOWNLOAD ITEM FILE (range requests supported for large PDFs)
GET {{rootURL}}/api/VaultItem/11/files/Documents/TRS80-M100-User-Guide.pdf

### DOWNLOAD ITEM FILE (nested subfolder, spaces in name)
GET {{rootURL}}/api/VaultItem/11/files/Images/Orig. Box images/Box_Front.png

### UPLOAD ITEM FILES (optional subfolder form field)
POST {{rootURL}}/api/VaultItem/11/files/Documents
Content-Type: multipart/form-data; boundary=----RetroVaultBoundary

------RetroVaultBoundary
Content-Disposition: form-data; name="files"; filename="New Manual.pdf"
Content-Type: application/pdf

< ./Library/11/Documents/TRS-80 Model 100 Quick Reference Guide.pdf
------RetroVaultBoundary
Content-Disposition: form-data; name="subfolder"

Scans
------RetroVaultBoundary--

### DELETE ITEM FILE (query params handle spaces and subfolders)
DELETE {{rootURL}}/api/VaultItem/11/files?category=Documents&path=Scans/New Manual.pdf
Accept: application/json
###